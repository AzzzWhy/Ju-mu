<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Scribe.Desktop.MainWindow"
        Title="句幕 · Ren’Py 剧本导入器" Icon="/Assets/Jumu.png" Width="1440" Height="940" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,14">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Background="#236752" CornerRadius="12" Width="48" Height="48"><TextBlock Text="幕" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Spacing="2"><TextBlock Text="句幕" FontSize="24" FontWeight="Bold"/><TextBlock Text="REN’PY SCRIPT IMPORTER  /  0.3.4" Classes="muted" FontSize="10" LetterSpacing="1.4"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Name="HelpButton" Content="使用说明"/>
        <Button Name="OpenProjectButton" Content="打开工程"/>
        <Button Name="SaveProjectButton" Content="保存工程"/>
        <Button Name="ChoiceTreeButton" Content="选项树" IsEnabled="False"/>
        <Button Name="ExportButton" Content="导出 .rpy  ↗" Classes="primary"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="panel" Padding="18,14" Margin="0,0,0,16">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Name="ImportButton" Content="＋ 导入稿件" Classes="soft"/>
          <StackPanel VerticalAlignment="Center" MaxWidth="350"><TextBlock Name="FileNameText" Text="从一份故事开始" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="支持 TXT · DOCX · Markdown，或直接粘贴原文" Classes="muted"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Name="SampleButton" Content="载入示例"/>
          <Button Name="SettingsButton" Content="角色与导出设置"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,28,0">
            <RadioButton Name="NovelMode" Content="小说正文" GroupName="mode" IsChecked="True"/>
            <RadioButton Name="ScriptMode" Content="剧本" GroupName="mode"/>
          </StackPanel>
          <ComboBox Grid.Column="1" Name="SplitChoice" Width="132" SelectedIndex="1" Margin="0,0,10,0"><ComboBoxItem Content="保留原段落"/><ComboBoxItem Content="按句子拆分"/><ComboBoxItem Content="按阅读长度"/></ComboBox>
          <TextBlock Grid.Column="2" Text="建议字数" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <NumericUpDown Grid.Column="3" Name="LengthInput" Value="80" Minimum="20" Maximum="500" Increment="10" Width="120" FormatString="0" ShowButtonSpinner="False" TextAlignment="Center"/>
          <StackPanel Grid.Column="4" Margin="18,0,8,0" VerticalAlignment="Center" Spacing="2">
            <CheckBox Name="AutoDetectCheck" Content="自动识别对白与角色" IsChecked="False" FontSize="12"/>
            <TextBlock Name="ModeHint" Text="默认：旁白/人物动作或其他" Classes="muted" FontSize="10"/>
          </StackPanel>
          <Button Grid.Column="5" Name="ParseButton" Content="解析文本 →" Classes="primary" HorizontalAlignment="Right"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="0.95*,12,1.2*,12,310">
      <Border Classes="panel" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock Text="01  原始稿件" Classes="caption"/><TextBlock Name="SourceCount" Grid.Column="1" Text="0 字" Classes="muted"/></Grid>
          <TabControl Name="SourceTabs" Grid.Row="1">
            <TabItem Header="原文"><TextBox Name="SourceBox" AcceptsReturn="True" TextWrapping="Wrap" Watermark="把你的故事粘贴在这里，或点击「导入稿件」。" BorderThickness="0" Padding="2,12" FontSize="14" LineHeight="26" ScrollViewer.VerticalScrollBarVisibility="Auto"/></TabItem>
            <TabItem Header=".rpy 预览"><TextBox Name="RpyBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Code, Menlo, Consolas" BorderThickness="0" Padding="2,12" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></TabItem>
          </TabControl>
          <TextBlock Grid.Row="2" Name="SourceHint" Text="原文可编辑 · 修改后点击「解析文本」" Classes="muted" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Classes="panel" Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14"><TextBlock Text="02  识别结果" Classes="caption"/><Button Grid.Column="1" Name="UndoButton" Content="撤销" Padding="10,3" FontSize="12"/></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBox Name="SearchBox" Watermark="搜索角色或正文…"/><CheckBox Name="PendingOnly" Grid.Column="1" Content="待确认" Margin="12,0,0,0"/></Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Name="SelectVisibleButton" Content="全选当前结果" FontSize="11" Padding="8,4"/>
            <Button Name="ReviewSelectedButton" Content="审核所选" FontSize="11" Padding="8,4" Classes="soft"/>
            <Button Name="ClearSelectionButton" Content="清除多选" FontSize="11" Padding="8,4"/>
            <TextBlock Name="SelectionCount" Text="已选 0 条" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="点击/拖动可多选 · Shift 选范围" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="QuickChoiceText" Watermark="输入选项文字"/>
              <Button Name="QuickAddChoiceButton" Grid.Column="1" Content="＋ 添加选项" Classes="soft" Margin="8,0,0,0" IsEnabled="False"/>
            </Grid>
            <TextBlock Text="选中句子：接在本句后；未选中：接在正文末尾。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid Grid.Row="4">
            <ListBox Name="SegmentList" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate>
                <Border Padding="10" BorderBrush="#E5ECE4" BorderThickness="0,0,0,1">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding SpeakerLabel}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Paragraph, StringFormat='¶ {0}'}" Classes="muted"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="#92732C" FontSize="11"/></Grid>
                    <TextBlock Text="{Binding Preview}" FontSize="14" LineHeight="23" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="20">
              <TextBlock Text="让故事，走进对话框。" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="导入或粘贴稿件，选择模式后开始解析。&#10;不确定的内容会标出，由你决定。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" LineHeight="23"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="5" Background="#F1F5EF" CornerRadius="8" Padding="10" Margin="0,10,0,0"><TextBlock Name="StatsText" Text="0 条内容  ·  0 位角色  ·  0 条待确认" FontSize="12" TextWrapping="Wrap"/></Border>
        </Grid>
      </Border>
      <Border Grid.Column="4" Classes="panel" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="03  逐句校正" Classes="caption" Margin="0,0,0,18"/>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="EditorPanel" Spacing="11" IsEnabled="False">
              <TextBlock Name="SelectionInfo" Text="选择一条识别结果" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="内容类型" Classes="caption"/><ComboBox Name="KindChoice" HorizontalAlignment="Stretch"><ComboBoxItem Content="旁白/人物动作或其他"/><ComboBoxItem Content="对白"/><ComboBoxItem Content="场景 / 舞台说明"/></ComboBox>
              <TextBlock Text="说话人" Classes="caption"/><TextBox Name="SpeakerBox" Watermark="输入角色名"/>
              <TextBlock Text="快捷人物姓名" Classes="caption"/><ComboBox Name="SpeakerShortcutChoice" HorizontalAlignment="Stretch"/>
              <TextBlock Text="正文" Classes="caption"/><TextBox Name="DialogueBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="240" FontSize="14" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              <Border Background="#FFF7E6" CornerRadius="8" Padding="10"><TextBlock Name="WarningText" Text="" Foreground="#86642B" FontSize="12" TextWrapping="Wrap" LineHeight="20"/></Border>
              <CheckBox Name="IncludeCheck" Content="包含在导出中" IsChecked="True"/>
              <Button Name="ApplyButton" Content="应用修改并确认" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <Grid ColumnDefinitions="*,6,*,6,*"><Button Name="MoveUpButton" Content="↑ 上移" FontSize="12" Padding="6" HorizontalAlignment="Stretch"/><Button Name="MoveDownButton" Grid.Column="2" Content="↓ 下移" FontSize="12" Padding="6" HorizontalAlignment="Stretch"/><Button Name="DeleteSegmentButton" Grid.Column="4" Content="删除句子" FontSize="12" Padding="6" HorizontalAlignment="Stretch"/></Grid>
              <Grid ColumnDefinitions="*,8,*"><Button Name="SplitButton" Content="在光标处拆分" FontSize="12" Padding="8" HorizontalAlignment="Stretch"/><Button Name="MergeButton" Grid.Column="2" Content="合并下一条" FontSize="12" Padding="8" HorizontalAlignment="Stretch"/></Grid>
              <Grid ColumnDefinitions="*,8,*"><Button Name="AddChoiceBeforeButton" Content="在本句前添加选项" FontSize="12" Padding="8" HorizontalAlignment="Stretch"/><Button Name="AddChoiceAfterButton" Grid.Column="2" Content="在本句后添加选项" FontSize="12" Padding="8" HorizontalAlignment="Stretch"/></Grid>
              <TextBlock Text="单句可上移、下移或删除；列表中也可按 Alt+↑ / Alt+↓ / Delete。移动时选项树跟随句子；删除关联选项树前会提示。多选只批量应用改动过的字段。" Classes="muted" TextWrapping="Wrap" LineHeight="20"/>
              <Border BorderBrush="#DFE6DD" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,12,0,0"><StackPanel Spacing="8"><TextBlock Text="原文定位" Classes="caption"/><TextBlock Name="OriginalSnippet" FontSize="12" Foreground="#6E8079" TextWrapping="Wrap" MaxHeight="130"/></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><TextBlock Name="StatusText" Text="就绪。稿件在本机处理。" FontSize="12" Foreground="#61796D" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="本地处理  /  无需联网" Classes="muted" Margin="20,0,0,0"/></Grid>
  </Grid>
</Window>
